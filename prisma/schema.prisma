generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String
  salt                    String
  name                    String
  coachingRole            String
  emailVerified           Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  lastRoute               String?
  role                    String    @default("user")
  subscriptionPlan        String    @default("free")
  subscriptionRenewsAt    DateTime?
  lastSeenAt              DateTime?
  loginCount              Int       @default(0)
  proTrialEndsAt          DateTime?
  paymentGraceEndsAt      DateTime?
  lastPaymentFailedAt     DateTime?
  customMonthlyPriceEur   Decimal?  @db.Decimal(10, 2)
  stripeCustomerId        String?   @unique
  stripeSubscriptionId    String?   @unique
  nametag                 String?   @unique
  /** Conta de treinador ligada a um presidente (modo clube); o presidente lê o workspace destes utilizadores. */
  clubPresidentUserId     String?
  clubPresident           User?     @relation("ClubPresidentCoaches", fields: [clubPresidentUserId], references: [id], onDelete: SetNull)
  coachesLinkedToClub     User[]    @relation("ClubPresidentCoaches")
  /** Lugar numerado (0–9) criado pelo presidente; null = ligação manual sem lugar fixo. */
  trainerSeatIndex        Int?
  /** Se false, o treinador não entra nem recebe Pro via presidente (revogado). */
  trainerSeatActive       Boolean   @default(true)
  /** Lugares extra comprados pelo presidente (cada um adiciona +1 ao limite base). */
  trainerExtraSeatsPurchased Int    @default(0)
  /** Quando o presidente (ou o próprio) invalida credenciais; JWT emitido antes desta data deixa de ser aceite. */
  sessionInvalidatedAt    DateTime?

  workspace                     Workspace?
  workspaceVersions             WorkspaceVersion[]
  appEvents                     AppEvent[]
  fullPersonalizationRequests   FullPersonalizationRequest[]

  @@index([clubPresidentUserId])
}

model Workspace {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload   Json
  updatedAt DateTime @updatedAt
}

model WorkspaceVersion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payload   Json
  source    String   @default("autosave")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AppEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model FullPersonalizationRequest {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String    @default("requested")
  requestedAt      DateTime  @default(now())
  approvedAt       DateTime?
  declinedAt       DateTime?
  scheduledFor     DateTime?
  contactEmail     String
  notesFromCoach   String?
  preferredDateNotes String?
  adminNotes       String?
  updatedAt        DateTime  @updatedAt

  @@index([status, requestedAt])
  @@index([scheduledFor])
}

model DmChatMessage {
  id           String   @id
  threadKey    String
  authorUserId String
  authorName   String
  body         String
  sentAt       DateTime @default(now())
  attachments  Json?

  @@index([threadKey, sentAt])
}

model CoachOfMonthContent {
  id              String   @id @default("global")
  payload         Json
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
}
