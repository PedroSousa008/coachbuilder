# Base de dados PostgreSQL (ex.: Neon, Supabase, Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Segredo para assinar cookies de sessão (gera uma string longa aleatória)
SESSION_SECRET="mínimo-16-caracteres-recomendado-32+"

# Recomendado true em produção (sync + mensagens de persistência). O login e o /me tentam a API cloud na mesma sem isto, para não perderes o role admin.
NEXT_PUBLIC_ENABLE_CLOUD_SYNC="true"

# Opcional: email que vê o link Admin no cliente (default no next.config se omitires). Servidor ainda exige role admin ou promoção via API.
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL=sousa.2003pedro@gmail.com

# Email(s) que recebem role "admin" e acesso a /app/admin (vários: separar por vírgula; sem aspas extra na Vercel)
ADMIN_OWNER_EMAIL=teu-email@gmail.com
