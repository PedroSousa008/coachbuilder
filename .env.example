# Base de dados PostgreSQL (ex.: Neon, Supabase, Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Opcional: URL direta Neon (dashboard "Direct"). O build na Vercel deriva-a do pooler removendo "-pooler." no host;
# só precisas de DIRECT_URL se esse formato mudar ou a password/user forem diferentes entre pool e direct.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Segredo para assinar cookies de sessão (gera uma string longa aleatória)
SESSION_SECRET="mínimo-16-caracteres-recomendado-32+"

# Recomendado true em produção (sync + mensagens de persistência). O login e o /me tentam a API cloud na mesma sem isto, para não perderes o role admin.
NEXT_PUBLIC_ENABLE_CLOUD_SYNC="true"

# Opcional: email que vê o link Admin no cliente (default no next.config se omitires). Servidor ainda exige role admin ou promoção via API.
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL=sousa.2003pedro@gmail.com

# Preço público Coach Pro (€/mês). ADMIN_PRO_MONTHLY_PRICE_EUR mantém compatibilidade.
COACH_PRO_MONTHLY_PRICE_EUR=6.99
ADMIN_PRO_MONTHLY_PRICE_EUR=6.99

# Palavra-passe da conta dono criada pelo seed / primeiro login automático (mín. 8 caracteres). Sem isto usa o default do código.
# BOOTSTRAP_OWNER_PASSWORD=pedrosousa10
# BOOTSTRAP_OWNER_NAME=Pedro Sousa
# BOOTSTRAP_OWNER_COACHING_ROLE=head-coach

# Email(s) que recebem role "admin" e acesso a /app/admin (vários: separar por vírgula; sem aspas extra na Vercel)
ADMIN_OWNER_EMAIL=teu-email@gmail.com

# Stripe (Coach Pro — subscrição mensal)
# STRIPE_SECRET_KEY=sk_live_... ou sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_... (criar em Stripe → Webhook → URL abaixo)
# Webhook (colar no Stripe, não na Vercel): https://coachbuilder.vercel.app/api/stripe/webhook
# STRIPE_PRICE_ID_COACH_PRO=price_... (preço mensal no Stripe)
# URL pública (success/cancel do Checkout). Opcional na Vercel se VERCEL_URL já for coachbuilder.vercel.app
# NEXT_PUBLIC_APP_URL=https://coachbuilder.vercel.app

# OpenAI — Análise Adversário AI (Sketch Area). Sem isto, o botão de geração devolve erro 503.
# OPENAI_API_KEY=sk-...
# Opcional: modelo (default gpt-4o-mini)
# OPENAI_OPPONENT_ANALYSIS_MODEL=gpt-4o-mini
